// The relay between the phone page and the TV: one Durable Object per room, the room id in the TV's QR code.
// Deploy: cd wiimote && npx wrangler deploy. The TV finds it at wiimote_url (the launcher's config.xml).
{
  "name": "wiimote",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Its one address, on a domain of the account's; a fork puts its own here and in wiimote_url.
  "routes": [{ "pattern": "wiimote.mauroproto.com", "custom_domain": true }],
  // No workers.dev address: it would carry the account's subdomain.
  "workers_dev": false,
  "preview_urls": false
}
